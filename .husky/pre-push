#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "Running type checking and tests before push..."

npm run typecheck
if [ $? -ne 0 ]; then
  echo "❌ Type checking failed. Push aborted."
  exit 1
fi

npm run test:ci
if [ $? -ne 0 ]; then
  echo "❌ Tests failed. Push aborted."
  exit 1
fi

echo "✅ All checks passed. Proceeding with push."
